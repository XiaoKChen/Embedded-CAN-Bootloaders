# Brain OTA over Ethernet — committed defaults (sdkconfig itself is generated).
CONFIG_IDF_TARGET="esp32s3"

# WROOM-1U-N16R8: 16 MB flash, with its own A/B table (not the node's).
# The octal PSRAM (GPIO35-37) stays disabled: nothing here needs it.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# W5500 on SPI2 (esp_eth's raw-MAC driver under lwIP).
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# esp_http_server has no enable switch: it is linked because main requires
# it. Its defaults (512-byte headers, 512-byte URIs) suffice.

# Logs on UART0 (GPIO43/44) and, as secondary output, on USB-Serial-JTAG
# (the brain's USB port). These are the esp32s3 defaults, stated explicitly.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
