# Bench-test app — committed defaults (sdkconfig itself is generated).
CONFIG_IDF_TARGET="esp32s3"

# The node updater's 4 MB layout, read from node_updater/ (single source of truth).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../node_updater/partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Console on the S3's USB-Serial-JTAG port. Only the primary console reads
# input (the `u` command); the secondary is output-only.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
