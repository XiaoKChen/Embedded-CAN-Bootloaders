menu "CAN Updater"

    config CAN_UPDATER_TWAI_TX_GPIO
        int "TWAI TX GPIO (to transceiver TXD)"
        range 0 48
        default 4
        help
            GPIO driving the external 3.3 V CAN transceiver's TXD input. TWAI
            is routed through the GPIO matrix, so any free output-capable pin
            works. Avoid strapping pins (0, 3, 45, 46), USB (19, 20), the
            flash/PSRAM pins (26-37 on octal-PSRAM modules) and UART0 (43, 44).

    config CAN_UPDATER_TWAI_RX_GPIO
        int "TWAI RX GPIO (from transceiver RXD)"
        range 0 48
        default 5
        help
            GPIO reading the external CAN transceiver's RXD output. Same pin
            constraints as the TX GPIO.

    choice CAN_UPDATER_BITRATE
        prompt "CAN bitrate"
        default CAN_UPDATER_BITRATE_250K
        help
            Must match the host (can_flash.py --bitrate, default 250000).

        config CAN_UPDATER_BITRATE_125K
            bool "125 kbit/s"
        config CAN_UPDATER_BITRATE_250K
            bool "250 kbit/s"
        config CAN_UPDATER_BITRATE_500K
            bool "500 kbit/s"
        config CAN_UPDATER_BITRATE_1M
            bool "1 Mbit/s"
    endchoice

    config CAN_UPDATER_BITRATE_BPS
        int
        default 125000 if CAN_UPDATER_BITRATE_125K
        default 250000 if CAN_UPDATER_BITRATE_250K
        default 500000 if CAN_UPDATER_BITRATE_500K
        default 1000000 if CAN_UPDATER_BITRATE_1M

endmenu
