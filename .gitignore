# =============================================================================
# .gitignore — Arduino-Custom-Bootloader (Rust/Embassy CAN bootloader)
# =============================================================================
# Files and directories that should NEVER be tracked by git.
# Keep this file grouped by purpose so it stays readable as the project grows.
# =============================================================================


# -----------------------------------------------------------------------------
# Build artifacts
# -----------------------------------------------------------------------------
# Cargo build output. Cargo.lock IS tracked — firmware binaries want
# reproducible dependency resolution.
target/

# Flashable artifacts exported out of target/ (probe-rs/objcopy output).
*.elf
*.bin
*.hex
*.uf2
*.map

# Exported artifact bundle produced by scripts/build-out.sh (reproducible).
out/


# -----------------------------------------------------------------------------
# Secrets — never in the repo
# -----------------------------------------------------------------------------
*.pem
*.key
*_private*
.env
.env.*


# -----------------------------------------------------------------------------
# VS Code per-machine state
# -----------------------------------------------------------------------------
.vscode/launch.json
.vscode/settings.json


# -----------------------------------------------------------------------------
# JetBrains IDE state (RustRover, CLion, etc.)
# -----------------------------------------------------------------------------
.idea/


# -----------------------------------------------------------------------------
# Claude Code project state
# -----------------------------------------------------------------------------
# `.claude/` rules/skills ARE committed in this template — but per-developer
# overrides (memory, settings.local.json) should not be. Narrow this rule if
# you choose to share the meta-config with the team.
.claude/settings.local.json
.claude/memory/

# Auto-generated by `/map`. Re-runnable from source.
project-table/
PROJECT.md


# -----------------------------------------------------------------------------
# C bootloader-era leftovers (live on the `main` branch, not the Embassy rewrite)
# -----------------------------------------------------------------------------
# These directories are tracked on `main` (the original C bootloader) and remain
# as untracked working-tree copies here after `version/embassy/ra4m1` cleared the C
# tree. They are NOT part of the Rust build; read them via `git show main:<path>`
# when needed. `build-host/` is the C project's CMake out-of-source build dir.
vendor/
tools/
build-host/


# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
