{
  "name": "can-update-esp32",
  "version": "1.0.0",
  "description": "Shared C code of the ESP32-S3 brain/node CAN updater for Arduino-ESP32 apps: CAN Update Protocol codecs, package parser, recovery counters, node flashing host, brain self-OTA and the node app's updater client. See docs/guides/platformio-arduino.md.",
  "keywords": ["can", "ota", "bootloader", "esp32", "twai"],
  "repository": {
    "type": "git",
    "url": "https://github.com/XiaoKChen/Embedded-CAN-Bootloaders.git",
    "branch": "version/c-cpp/esp32"
  },
  "frameworks": ["arduino", "espidf"],
  "platforms": ["espressif32"],
  "build": {
    "srcDir": ".",
    "includeDir": "src/boot",
    "srcFilter": [
      "+<src/boot/app_control.c>",
      "+<src/boot/crc32.c>",
      "+<src/boot/dfu_config.c>",
      "+<src/boot/update_pkg.c>",
      "+<src/boot/boot_counter.c>",
      "+<components/can_flash_host/can_flash_host.c>",
      "+<brain/main/ota_update.c>"
    ],
    "flags": [
      "-Icomponents/can_flash_host/include",
      "-Icomponents/can_updater_client/include",
      "-Ibrain/main"
    ],
    "extraScript": "platformio/library_build.py"
  },
  "export": {
    "include": [
      "library.json",
      "README.md",
      "platformio",
      "src/boot",
      "components/can_flash_host",
      "components/can_updater_client",
      "brain/main/ota_update.c",
      "brain/main/ota_update.h",
      "brain/partitions.csv",
      "node_updater/partitions.csv",
      "docs/guides/platformio-arduino.md"
    ]
  }
}
