# ESP32-S3 CAN updater — committed defaults (sdkconfig itself is generated).
CONFIG_IDF_TARGET="esp32s3"

# Build-time 4 MB layout (the IDU provisions partitions_idu_16MB.csv instead).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# A freshly CAN-flashed app boots PENDING_VERIFY; if it never calls
# esp_ota_mark_app_valid_cancel_rollback() the bootloader falls back to the
# updater on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# No GPIO factory-reset (CONFIG_BOOTLOADER_FACTORY_RESET): GPIO4 is the
# node's TWAI TX, so the bootloader would sample the transceiver's D line at
# reset. Phase 3 recovery (#9) selects factory without modifying otadata.

# Shared bootloader/app RTC contract; custom bytes have their own validation.
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC=y
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_SIZE=0x10
# CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_IN_CRC is not set

# A hung updater resets (back into itself) instead of only logging.
CONFIG_ESP_TASK_WDT_PANIC=y

# TinyUSB owns the internal PHY; UART0 remains the only logging console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
