# Reference node app — committed defaults (sdkconfig itself is generated).
CONFIG_IDF_TARGET="esp32s3"

# The node updater's 4 MB layout, read from node_updater/ (single source of
# truth); build.ps1/build.sh treat a project naming this table as an OTA app.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../node_updater/partitions.csv"

# A CAN-flashed image boots PENDING_VERIFY and rolls back to the updater unless
# the self-test confirms it.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Phase 3 recovery contract with the node's bootloader (can_updater_client
# refuses to build without it): 16 custom RTC bytes, outside the IDF CRC.
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC=y
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_SIZE=0x10
# CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_IN_CRC is not set

# Logs on the S3's USB-Serial-JTAG port (the node's USB connector).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
